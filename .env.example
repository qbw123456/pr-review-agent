# API Key (required)
ANTHROPIC_API_KEY=sk-ant-xxx

# Model ID (required)
MODEL_ID=claude-sonnet-4-6

# Base URL (optional, for Anthropic-compatible providers)
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Auto mode: use legacy single-agent when reviewable changed files <= N (default 6)
# REVIEW_LEGACY_MAX_FILES=6

# Parallel per-file subagents (subagent path only; default 4, max 16; use 1 for serial)
# REVIEW_SUBAGENT_WORKERS=4

# API rate-limit retries in agent_loop (default 5 retries, 10s base backoff, 120s cap)
# REVIEW_API_MAX_RETRIES=5
# REVIEW_API_RETRY_BASE_SEC=10
# REVIEW_API_RETRY_MAX_SEC=120

# LLM temperature in agent_loop (default 0.0 for stable reviews; range 0.0–1.0)
# REVIEW_TEMPERATURE=0

# Print token/timing summary after review (default on; set 0 to disable)
# REVIEW_LOG_USAGE=1

# Incremental review on PR update (default on; CI reads last_sha from PR comment)
# REVIEW_INCREMENTAL=1
# REVIEW_SINCE_SHA=<commit>
# REVIEW_PREVIOUS_REPORT=/path/to/previous-review.md
# REVIEW_FULL=1

# Team review rules YAML (default: ./review-rules.yaml in repo root)
# REVIEW_RULES_PATH=review-rules.yaml
